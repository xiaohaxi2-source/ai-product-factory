# 默认复用本机 Codex ChatGPT 登录，不填密钥、不自动切换 API 付费。
MODEL_BACKEND=codex
CODEX_BIN=codex
# 留空继承 Codex 当前配置的模型；实际模型写入调用记录。
MODEL_NAME=
CODEX_EFFORT=low
# 自动为Codex子进程继承系统代理；显式HTTP_PROXY/HTTPS_PROXY/ALL_PROXY优先。
CODEX_USE_SYSTEM_PROXY=true
MODEL_TIMEOUT=120
# 编码按小批次生成，每批单独计时；访谈与文档仍使用MODEL_TIMEOUT。
DEVELOPMENT_TIMEOUT=300
MODEL_MAX_RETRIES=1
MAX_CALLS=60
PORT=8124
# DATA_DIR 不填，默认落产品文件夹 data/；测试可设置隔离目录。
